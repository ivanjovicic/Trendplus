{
  "name": "Trendplus Full Stack",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend-api",
      "command": "cd Api && ASPNETCORE_ENVIRONMENT=Development PORT=8080 dotnet run -c Debug --project Api.csproj"
    },
    {
      "name": "frontend",
      "command": "cd Klijent/clientapp && npm run dev"
    }
  ],
  "ports": [
    {
      "name": "backend-api",
      "port": 8080
    },
    {
      "name": "frontend",
      "port": 5174
    },
    {
      "name": "postgres",
      "port": 5434
    }
  ]
}
