{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "RabbitMq": {
    "HostName": "",
    "Port": 5671,
    "UserName": "",
    "Password": "",
    "VirtualHost": "",
    "ExchangeName": "trendplus.events",
    "ExchangeType": "topic",
    "UseSsl": true,
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "AnalyticsConnection": ""
  },
  "Unsplash": {
    "AccessKey": ""
  },
  "Pexels": {
    "ApiKey": ""
  },
  "OpenProductTraining": {
    "DefaultDatasets": [
      "kaggle_shoe_dataset",
      "amazon_clothing_shoes",
      "ebay_shoes",
      "google_shopping_shoes"
    ]
  },
  "RuntimeScoring": {
    "PythonModelBaseUrl": "http://localhost:8000",
    "PredictPath": "/predict",
    "EnablePythonPredict": false,
    "PythonTimeoutSeconds": 20,
    "DefaultMarket": "RS"
  }
}
