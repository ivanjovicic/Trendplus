{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:8080",
      "https://trendplus.vercel.app"
    ]
  },
  "Swagger": {
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5434;Database=trendplus;Username=postgres;Password=postgres;",
    "AnalyticsConnection": "Host=127.0.0.1;Port=5434;Database=analytics;Username=postgres;Password=postgres;",
    "OpenProductTrainingConnection": "Host=127.0.0.1;Port=5434;Database=analytics;Username=postgres;Password=postgres;",
    "Redis": "localhost:6379"
  },
  "Database": {
    "CommandTimeoutSeconds": 300,
    "Npgsql": {
      "OpenTimeoutSeconds": 15,
      "KeepAliveSeconds": 30,
      "EnableEfRetryOnFailure": true,
      "EfRetry": {
        "MaxRetryCount": 3,
        "MaxRetryDelaySeconds": 5
      }
    }
  },
  "DatabaseInitialization": {
    "RunFullSupplierDecisionHubOnStartup": false,
    "AllowSupplierDecisionHeavyRefreshInInitializer": false
  },
  "AccessImport": {
    "WorkerEnabled": true,
    "RegisterWorkerInWebProcess": true,
    "PollingIntervalSeconds": 2,
    "MaxConcurrentJobs": 1,
    "CliTimeoutSeconds": 60,
    "PreviewSampleTake": 50,
    "MaxMetadataParallelism": 2,
    "DbSaveBatchSize": 1000,
    "StatusUpdateThrottleSeconds": 5,
    "HeartbeatIntervalSeconds": 5,
    "MaxRetryCount": 1,
    "EnableAutoRetryForTransientFailures": false,
    "StorageRoot": "tmp/access-import-jobs",
    "EnableSnapshotCopy": true,
    "PendingBatchStaleMinutes": 10,
    "PendingBatchRecoveryIntervalSeconds": 60,
    "RunningBatchStaleMinutes": 240,
    "EnableMdbSql": false,
    "PreventConcurrentRuns": true,
    "SkipInvalidForeignKeys": true,
    "AutoInsertMissingParents": true
  },
  "BackendRouting": {
    "PrimaryProvider": "render",
    "FallbackEnabled": false,
    "FallbackProvider": "fly",
    "Providers": {
      "RenderUrl": "https://trendplus-api.onrender.com",
      "FlyUrl": "https://trendplus.fly.dev"
    }
  },
  "Documents": {
    "SyncRowLimit": 5000,
    "WorkerBatchSize": 4,
    "SignedUrlTtlMinutes": 30,
    "FileTtlHours": 72,
    "StorageRoot": "out/documents",
    "CsvDelimiter": "comma",
    "SigningKey": ""
  },

  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "trendplus.events",
    "ExchangeType": "topic",
    "Enabled": false
  },
  
  "EmbeddingService": {
    "BaseUrl": "http://localhost:8000",
    "Timeout": 30,
    "UseMock": true
  },
  
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Unsplash": {
    "AccessKey": "",
    "AppName": "trendplus"
  },
  "Pexels": {
    "ApiKey": ""
  },
  "Admin": {
    "ApiKey": ""
  },
  "SerpApi": {
    "ApiKey": "",
    "AmazonDomain": "amazon.de",
    "MaxResults": 50,
    "TimeoutSeconds": 20
  },
  "Ebay": {
    "ClientId": "",
    "ClientSecret": "",
    "DevId": "",
    "IsSandbox": false,
    "OAuthToken": "",
    "Marketplace": "EBAY_DE",
    "Currency": "EUR",
    "MaxResults": 50,
    "TimeoutSeconds": 20
  },
  "GoogleShopping": {
    "CountryCode": "de",
    "Language": "de",
    "Currency": "EUR",
    "MaxResults": 50,
    "TimeoutSeconds": 25
  },
  "OpenProductTraining": {
    "DefaultDatasets": [
      "kaggle_shoe_dataset",
      "amazon_clothing_shoes",
      "ebay_shoes",
      "google_shopping_shoes"
    ]
  },
  "RuntimeScoring": {
    "PythonModelBaseUrl": "http://localhost:8000",
    "PredictPath": "/predict",
    "EnablePythonPredict": false,
    "PythonTimeoutSeconds": 20,
    "DefaultMarket": "RS",
    "Tuning": {
      "MarketplaceCoverageItemsPerUnit": 200,
      "MarketplaceCoverageMaxUnits": 3,
      "SourceCoverageNormalizationMaxUnits": 6,
      "PriceFitExponentialDecay": 3.0,
      "DealTanhMultiplier": 4.0,
      "ConfidenceBase": 20.0,
      "ConfidenceTrainingBonus": 25.0,
      "ConfidencePerSource": 8.0,
      "ConfidenceSourceCap": 30.0,
      "ConfidenceImageDivisor": 5.0,
      "ConfidenceImageCap": 15.0,
      "ConfidenceBaselineBonus": 10.0,
      "ConfidenceCap": 95.0
    },
    "Enterprise": {
      "Enabled": true,
      "PreferModelVersionParameters": true,
      "ModelType": "enterprise_scoring",
      "ModelRefreshSeconds": 60,
      "Bias": -4.0,
      "CalibrationA": 1.0,
      "CalibrationB": 0.0,
      "Temperature": 0.7,
      "SoftmaxBlendWeight": 0.10,
      "HeuristicWeightWithExternalModel": 0.20,
      "ExternalModelWeight": 0.65,
      "EnterpriseWeightWithExternalModel": 0.15,
      "HeuristicWeightWithoutExternalModel": 0.25,
      "EnterpriseWeightWithoutExternalModel": 0.75,
      "FeatureWeights": {
        "price_fit": 1.15,
        "margin": 0.95,
        "popularity": 1.30,
        "trend_momentum": 0.90,
        "source_coverage": 0.65,
        "local_demand": 0.80,
        "image_similarity": 0.55,
        "deal_score": 0.85,
        "supplier_score": 0.40,
        "season_score": 0.35
      }
    }
  },
  "TrendIngestion": {
    "PythonApiBaseUrl": "http://localhost:8000",
    "Pages": 5,
    "Markets": [ "DE", "AT" ],
    "Top": 500,
    "RunAtHourUtc": 3,
    "PythonCallTimeoutSeconds": 300,
    "Enabled": true,
    "StartDelayMinutes": 30
  },
  "OpenTrainingModelTraining": {
    "Enabled": true,
    "StartupDelaySeconds": 30,
    "PollSeconds": 20,
    "PauseCheckSeconds": 5,
    "PythonExe": "python",
    "TrainingScriptPath": "Python/training/train_sell_probability_rs.py",
    "OutputDir": "out/models/open_training",
    "Take": 500000,
    "ActivateOnSuccess": true
  },
  "NightlyAnalyticsRefresh": {
    "Enabled": true,
    "RunAtUtc": "00:10",
    "RefreshConcurrently": true,
    "CatchUpIfMissed": true,
    "CatchUpMaxHours": 4,
    "GracePeriodMinutes": 15,
    "StartupDelaySeconds": 30,
    "PauseCheckSeconds": 5,
    "HeartbeatSeconds": 300,
    "CommandTimeoutSeconds": 1800,
    "MaterializedViewsToRefresh": [
      "mv_daily_sales_facts",
      "mv_sales_rolling_7d",
      "mv_sales_momentum",
      "supplier_training_dataset_v1",
      "mv_supplier_markdown_dependency_cache",
      "mv_supplier_decision_score_cache",
      "mv_supplier_recommendations_cache"
    ],
    "IntelligenceMaterializedViewsToRefresh": [
      "analytics_intel.mv_product_demand_signals_v1_cache",
      "analytics_intel.mv_inventory_risk_signals_v1_cache",
      "analytics_intel.mv_price_intelligence_v1_cache",
      "analytics_intel.mv_trend_momentum_v1_cache"
    ],
    "VacuumAnalyzeTargets": [
      "prodaja_stavke",
      "prodaja_zaglavlje",
      "mv_daily_sales_facts"
    ],
    "OpenTrainingMaterializedViewsToRefresh": [
      "mv_brand_shoe_runtime_priors"
    ],
    "QueueSupplierRankingTraining": true
  },
  "AnalyticsDataQualityHealth": {
    "Enabled": true,
    "StartupDelaySeconds": 45,
    "PauseCheckSeconds": 30,
    "PollIntervalMinutes": 60,
    "LookbackDays": 90,
    "WarningOrphanArticleCount": 10,
    "WarningUnknownSupplierRevenueSharePct": 3.0,
    "WarningMissingCostRevenueSharePct": 5.0,
    "MinSalesForNoisyIssuesRsd": 1000,
    "TopOffenderLimit": 10,
    "ScoreMissingCostWeight": 0.5,
    "ScoreUnknownSupplierWeight": 0.3,
    "ScoreOrphanWeight": 0.2,
    "ScorePenaltyAtWarning": 0.45,
    "ScoreCriticalMultiplier": 3.0
  },
  "Analytics": {
    "UseSnapshotCost": false,
    "SnapshotAdminEnabled": false,
    "ActiveBatchStaleAfterHours": 72
  }
}
