{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "trendplus.events",
    "ExchangeType": "topic",
    "UseSsl": false,
    "Enabled": false
  },
  "Workers": {
    "Enabled": true
  },
  "Documents": {
    "SyncRowLimit": 5000,
    "WorkerBatchSize": 4,
    "SignedUrlTtlMinutes": 30,
    "FileTtlHours": 72,
    "StorageRoot": "out/documents",
    "CsvDelimiter": "comma",
    "SigningKey": ""
  },
  "Caching": {
    "UseRedis": false
  },
  "AnalyticsPrewarm": {
    "Enabled": false,
    "InitialDelaySeconds": 12,
    "RequestTimeoutSeconds": 45
  },
  "Unsplash": {
    "AccessKey": ""
  },
  "Pexels": {
    "ApiKey": ""
  },
  "Admin": {
    "ApiKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5434;Database=trendplus;Username=postgres;Password=postgres;",
    "AnalyticsConnection": "Host=127.0.0.1;Port=5434;Database=trendplus;Username=postgres;Password=postgres;",
    "OpenProductTrainingConnection": "Host=127.0.0.1;Port=5434;Database=trendplus;Username=postgres;Password=postgres;"
  },
  "OpenProductTraining": {
    "DefaultDatasets": [
      "kaggle_shoe_dataset",
      "amazon_clothing_shoes",
      "ebay_shoes",
      "google_shopping_shoes"
    ]
  },
  "RuntimeScoring": {
    "PythonModelBaseUrl": "http://localhost:8000",
    "PredictPath": "/predict",
    "EnablePythonPredict": false,
    "PythonTimeoutSeconds": 20,
    "DefaultMarket": "RS"
  },
  "TrendIngestion": {
    "PythonApiBaseUrl": "http://localhost:8000",
    "Pages": 5,
    "Markets": [ "DE", "AT" ],
    "Top": 500,
    "RunAtHourUtc": 3,
    "PythonCallTimeoutSeconds": 300,
    "Enabled": true
  }
  ,
  "DatabaseInitialization": {
    "RunFullSupplierDecisionHubOnStartup": false
  },
  "AnalyticsDataQualityHealth": {
    "Enabled": true,
    "StartupDelaySeconds": 15,
    "PauseCheckSeconds": 15,
    "PollIntervalMinutes": 30,
    "LookbackDays": 90,
    "WarningOrphanArticleCount": 10,
    "WarningUnknownSupplierRevenueSharePct": 3.0,
    "WarningMissingCostRevenueSharePct": 5.0,
    "MinSalesForNoisyIssuesRsd": 1000,
    "TopOffenderLimit": 10,
    "ScoreMissingCostWeight": 0.5,
    "ScoreUnknownSupplierWeight": 0.3,
    "ScoreOrphanWeight": 0.2,
    "ScorePenaltyAtWarning": 0.45,
    "ScoreCriticalMultiplier": 3.0
  }
  ,
  "PerformanceLogging": {
    "CaptureSql": false,
    "MaxQueryLength": 2000,
    "SampleRate": 0.1
  },
  "Analytics": {
    "UseSnapshotCost": false,
    "SnapshotAdminEnabled": true,
    "ActiveBatchStaleAfterHours": 72
  }
}
