{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5434;Database=trendplus;Username=postgres;Password=postgres;",
    "AnalyticsConnection": "Host=127.0.0.1;Port=5434;Database=analytics;Username=postgres;Password=postgres;",
    "Redis": "localhost:6379"
  },

  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "trendplus.events",
    "ExchangeType": "topic",
    "Enabled": false
  },
  
  "EmbeddingService": {
    "BaseUrl": "http://localhost:8000",
    "Timeout": 30,
    "UseMock": true
  },
  
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Unsplash": {
    "AccessKey": "",
    "AppName": "trendplus"
  },
  "Pexels": {
    "ApiKey": ""
  },
  "SerpApi": {
    "ApiKey": "",
    "AmazonDomain": "amazon.de",
    "MaxResults": 50,
    "TimeoutSeconds": 20
  },
  "Ebay": {
    "ClientId": "",
    "ClientSecret": "",
    "DevId": "",
    "IsSandbox": false,
    "OAuthToken": "",
    "Marketplace": "EBAY_DE",
    "Currency": "EUR",
    "MaxResults": 50,
    "TimeoutSeconds": 20
  },
  "GoogleShopping": {
    "CountryCode": "de",
    "Language": "de",
    "Currency": "EUR",
    "MaxResults": 50,
    "TimeoutSeconds": 25
  },
  "OpenProductTraining": {
    "DefaultDatasets": [
      "kaggle_shoe_dataset",
      "amazon_clothing_shoes",
      "ebay_shoes",
      "google_shopping_shoes"
    ]
  },
  "RuntimeScoring": {
    "PythonModelBaseUrl": "http://localhost:8000",
    "PredictPath": "/predict",
    "EnablePythonPredict": false,
    "PythonTimeoutSeconds": 20,
    "DefaultMarket": "RS"
  }
}
