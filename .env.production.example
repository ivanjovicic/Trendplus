# RabbitMQ Production Credentials
RABBITMQ_USER=trendplus_prod_user
RABBITMQ_PASS=CHANGE_THIS_TO_STRONG_PASSWORD_123!

# Database Connections
DATABASE_CONNECTION=Host=your-postgres-host;Port=5432;Database=trendplus;Username=dbuser;Password=dbpass;SSL Mode=Require;Trust Server Certificate=true;

# API URLs
CORE_API_URL=https://api.trendplus.rs

# Frontend build-time API base (set this to your Fly URL if deploying frontend against Fly)
# Example: VITE_API_BASE_URL=https://trendplus.fly.dev
VITE_API_BASE_URL=https://trendplus.fly.dev
